# URL de base de l'API REST backend utilisée par Axios (/api passe par le proxy Vite en dev)
VITE_API_URL=/api
# Port du serveur de développement Frontend Vite
VITE_PORT=5173
# Cible du proxy /api en développement local
VITE_API_PROXY_TARGET=http://localhost:4000
# URL de production Vercel chargée par l'APK Android (Capacitor Mode Hybride)
VITE_CAPACITOR_SERVER_URL=https://votre-eparnio.vercel.app
