# --- Serveur & Base de données ---
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/eparnio
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=1mb

# --- Authentification, Sessions JWT & Hachage ---
JWT_SECRET=change-me-in-production-eparnio-secret-key
# Durée de validité de la session utilisateur JWT (ex: 24h, 7d, 12h, 30m)
JWT_EXPIRES_IN=24h
# Coût de hachage Bcrypt (mots de passe, clés de récupération et codes e-mail)
BCRYPT_SALT_ROUNDS=10

# --- Partage d'espaces & Anti-Brute-Force (Rate Limiting) ---
# Durée de validité (en heures) des liens et QR codes d'invitation à un budget partagé
INVITE_CODE_TTL_HOURS=24
# Fenêtre de limitation de débit (en minutes) et plafonds par IP
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
INVITE_RATE_LIMIT_MAX=15

# --- Réinitialisation de mot de passe par e-mail (SMTP Gmail gratuit) ---
# Créez un Mot de passe d'application Google (Compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eparnio <no-reply@eparnio.app>"
SMTP_TIMEOUT_MS=15000
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@eparnio.app
